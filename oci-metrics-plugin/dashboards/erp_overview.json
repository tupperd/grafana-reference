{
  "apiVersion": "dashboard.grafana.app/v2beta1",
  "kind": "Dashboard",
  "metadata": {
    "name": "erp-operations-demo"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "ERP KPI Dashboard — powered by Oracle Cloud Infrastructure Metrics",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Orders Per Minute by Channel",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "oci-metrics-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "YOUR_OCI_DATASOURCE_UID"
                      },
                      "spec": {
                        "compartment": "YOUR_COMPARTMENT_OCID",
                        "compartmentName": "YOUR_COMPARTMENT_NAME",
                        "dimensionValues": [],
                        "interval": "auto",
                        "legendFormat": "{{channel}}",
                        "metric": "",
                        "namespace": "erp_demo",
                        "queryTextRaw": "orders_per_minute[1m].groupBy(channel).avg()",
                        "rawQuery": false,
                        "region": "YOUR_OCI_REGION",
                        "resourcegroup": "order_mgmt",
                        "statistic": "avg()",
                        "tagsValues": [],
                        "tenancy": "DEFAULT/",
                        "tenancyName": "DEFAULT/",
                        "tenancymode": "single-tenancy"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.0.0-0",
            "spec": {
              "options": {
                "legend": {
                  "calcs": ["mean", "max", "last"],
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "hideZeros": false,
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "color": { "mode": "palette-classic" },
                  "custom": {
                    "drawStyle": "line",
                    "fillOpacity": 15,
                    "lineInterpolation": "smooth",
                    "lineWidth": 2,
                    "showPoints": "auto"
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
