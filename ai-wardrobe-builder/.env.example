# ---------------------------------------------------------------------------
# Wardrobe AI configuration. Copy to `.env` and fill in the Sigil/OTel values
# from your Grafana Cloud stack. The app runs WITHOUT these (AI works, but
# nothing is exported) so you can try it locally first.
# ---------------------------------------------------------------------------

# --- Light auth (plaintext is fine for a local learning app) ---
APP_USERNAME=admin
APP_PASSWORD=wardrobe
SESSION_SECRET=change-me-to-any-random-string

# --- Local LLM (Ollama, OpenAI-compatible) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b
LLM_PROVIDER=ollama

# ---------------------------------------------------------------------------
# Grafana Cloud AI Observability (Sigil) - generation export.
# Get these from your stack: Connections -> AI Observability app ->
# Configuration page. Token needs the `sigil:write` scope.
# ---------------------------------------------------------------------------
SIGIL_ENDPOINT=
SIGIL_PROTOCOL=http
SIGIL_AUTH_MODE=basic
SIGIL_AUTH_TENANT_ID=
SIGIL_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# OpenTelemetry traces + metrics (optional but recommended - lights up the
# token/cost/latency dashboards alongside the generations).
# From: Connections -> OpenTelemetry -> Configure.
# IMPORTANT: in the headers value, URL-encode the space after "Basic" as %20,
# or the Python OTLP/HTTP exporter mishandles the header.
# ---------------------------------------------------------------------------
OTEL_SERVICE_NAME=wardrobe-ai
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<zone>.grafana.net/otlp
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic%20<base64(instanceID:token)>"
