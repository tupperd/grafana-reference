# Copy to .env (gitignored) and fill in.
#
# REQUIRED: dedicated OnCall API key.
# personal_notification_rules is a user-settings endpoint that rejects Grafana
# service-account tokens with 403 "Invalid token". You must use an OnCall API
# key. Create one in your stack: IRM > Settings > API Keys (a.k.a. API Tokens).
# It is sent as a raw Authorization header (no "Bearer" prefix).
ONCALL_API_KEY=

# OPTIONAL: OnCall API base URL, including the /oncall suffix, e.g.
#   https://oncall-prod-<region>.grafana.net/oncall
# If left blank, the script auto-discovers it from your active gcx context
# (GET {server}/api/plugins/grafana-irm-app/settings -> jsonData.onCallApiUrl).
# Find it manually under IRM > Settings > API if you are not using gcx.
ONCALL_API_URL=
