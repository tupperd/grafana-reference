      "datasource": { "type": "datasource", "uid": "-- Mixed --" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service) (rate(http_requests_total{status_code=~\"5..\"}[2m])) / sum by (service) (rate(http_requests_total[2m])) * 100",
          "legendFormat": "{{service}}",
          "instant": false,
          "range": true,
          "hide": true
        },
        {
          "refId": "B",
          "datasource": { "type": "mysql", "uid": "mysql" },
          "rawQuery": true,
          "rawSql": "SELECT service, error_budget_pct, p99_threshold_ms, team, tier FROM slo_targets",
          "format": "table",
          "hide": true
        },
        {
          "refId": "C",
          "datasource": { "type": "__expr__", "uid": "__expr__" },
          "type": "sql",
          "expression": "SELECT\n  A.time,\n  A.service,\n  A.__value__                                    AS error_rate_pct,\n  COALESCE(B.error_budget_pct, ___)              AS effective_slo,\n  A.__value__ > COALESCE(B.error_budget_pct, ___) AS is_breaching\nFROM A\nLEFT JOIN B ON A.service = B.service\nWHERE A.__value__ > ___",
          "hide": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "error_rate_pct": true,
              "effective_slo": true
