# ─── Grafana Cloud ────────────────────────────────────────────────────────────
# Find these values in: Grafana Cloud → My Account → Stack → OpenTelemetry
#
# OTLP endpoint — usually:
#   https://otlp-gateway-prod-us-east-0.grafana.net/otlp
# (replace region slug to match your stack)
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp

# Numeric instance ID (shown as "Instance ID" in the Grafana Cloud portal)
GRAFANA_CLOUD_INSTANCE_ID=<your-instance-id>

# Service account token with MetricsPublisher + TracesPublisher roles
GRAFANA_CLOUD_API_KEY=<your-api-key>

# ─── SQL Server ───────────────────────────────────────────────────────────────
MSSQL_SA_PASSWORD=FooDemo!2024

# ─── Batch tuning ─────────────────────────────────────────────────────────────
# Set to a number 1-6 to inject SLA-breach latency on that step.
# Leave blank (or 0) for normal operation.
#
#   1 = load-trades
#   2 = validate-positions
#   3 = price-securities   ← good demo step (mid-chain, causes visible cascade)
#   4 = calculate-pnl
#   5 = generate-reports
#   6 = close-books
BATCH_SLOW_STEP=

# ─── Long-batch tuning ────────────────────────────────────────────────────────
# Seconds per step for the "Run Long Batch" mode (service.name=foo-batch-runner-long).
# Default: 900 (15 minutes × 6 steps = 90 minutes total).
# Set to a small value (e.g. 10) for local testing.
LONG_BATCH_STEP_SECONDS=
